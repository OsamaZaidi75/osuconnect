# Copy to .env.prod and fill in. Never commit .env.prod.
PUBLIC_DOMAIN=chat.example.com
PUBLIC_IP=203.0.113.10

POSTGRES_USER=semaphore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=semaphore
REDIS_PASSWORD=change-me

# openssl rand -base64 48
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# openssl rand -hex 32 (secret must be >= 32 chars)
LIVEKIT_API_KEY=osuconnect
LIVEKIT_API_SECRET=change-me

# Generate: docker compose run --rm backend node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

TRUST_PROXY=1
